{
  "manifest_version": 3,
  "name": "youtube-audio-dl importer",
  "version": "1.1.0",
  "description": "Capture Artiste - Titre depuis Deezer / Spotify / YouTube Music et envoie vers l'app locale youtube-audio-dl.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Envoyer vers youtube-audio-dl"
  },
  "permissions": ["activeTab", "clipboardWrite", "storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "content_scripts": [
    {
      "matches": [
        "https://open.spotify.com/*",
        "https://deezer.com/*",
        "https://www.deezer.com/*",
        "https://*.deezer.com/*",
        "https://music.youtube.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}

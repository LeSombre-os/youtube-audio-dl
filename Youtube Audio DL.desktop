[Desktop Entry]
Type=Application
Name=▶ Youtube Audio DL
Comment=Lance l'app locale (terminal + navigateur). Copier ce fichier dans ~/.local/share/applications/ si besoin.
Exec=bash -c 'cd "$(dirname "$(readlink -f "%k")")" && gnome-terminal -- ./lancer.sh'
Icon=applications-multimedia
Terminal=false
Categories=AudioVideo;Network;
